{
  "name": "harness",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "bin": {
    "harness": "dist/cli/index.js",
    "harness-server": "dist/server/index.js",
    "harness-tui": "dist/tui/index.js"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "dev:server": "tsx src/server/index.ts",
    "dev:cli": "tsx src/cli/index.ts",
    "dev:tui": "tsx src/tui/index.tsx",
    "tui": "tsx src/tui/index.tsx",
    "build": "tsc -p tsconfig.json",
    "build:bin": "bun build src/server/index.ts --compile --outfile bin/harness-server --target bun && bun build src/server/index.ts --compile --outfile bin/harness-server-linux-x64 --target bun-linux-x64 && bun build src/cli/index.ts --compile --outfile bin/harness --target bun && bun build src/tui/index.tsx --compile --outfile bin/harness-tui --target bun --external react-devtools-core",
    "start": "node dist/cli/index.js",
    "start:server": "node dist/server/index.js",
    "start:tui": "node dist/tui/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev:web": "pnpm --filter harness-web dev",
    "release": "node scripts/release.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.20.0",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "ink": "^7.0.3",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^4.1.1",
    "node-cron": "^4.2.1",
    "openai": "^6.39.0",
    "react": "^19.2.6",
    "untildify": "^6.0.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.1",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.15",
    "@types/ws": "^8.18.1",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
